<!DOCTYPE html>
<html lang="es">
    <%- include('partials/head',{title:'Iniciar Sesión - Macramé Rose'}) %>
<body>
    <%- include('partials/header') %>
    
    <main class="main-login">
        <div class="title-login">
            <h2>Iniciar Sesión</h2>
            <p style="color: var(--text-light); margin-top: 8px;">Accede a tu cuenta para continuar</p>
        </div>
        
        <form action="/user/login" method="POST" class="design-form">
            <div class="div-form">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" class="input-control email" placeholder="tucorreo@email.com" required>
                <% if(locals.errors && errors.email) {%>
                    <div class="text-danger"><i class="fas fa-exclamation-circle"></i><%= errors.email.msg %></div>
                <% } %>
            </div>
            
            <div class="div-form">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" class="input-control password" placeholder="••••••••" required>
                <% if(locals.errors && errors.password) {%>
                    <div class="text-danger"><i class="fas fa-exclamation-circle"></i><%= errors.password.msg %></div>
                <% } %>
            </div>
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin: var(--space-sm) 0;">
                <div class="rememberUser">
                    <input type="checkbox" id="rememberUser" name="rememberUser">
                    <label for="rememberUser">Recordarme</label>
                </div>
                <div class="div-a" style="margin: 0;">
                    <a href="#">¿Olvidaste tu contraseña?</a>
                </div>
            </div>
            
            <div id="div-button">
                <button type="submit" class="button-form">
                    <i class="fas fa-sign-in-alt" style="margin-right: 8px;"></i>Iniciar Sesión
                </button>
            </div>
            
            <div class="div-p">
                <p>¿No tienes una cuenta? <a href="/user/register">Crear cuenta</a></p>
            </div>
        </form>
    </main>
    
    <%- include('partials/footer') %>
</body>
<script src="/js/loginValidation.js"></script>
</html>

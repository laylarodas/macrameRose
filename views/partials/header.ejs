<header id="headerSection">
    <!-- Mobile Header -->
    <div id="header-mobile">
        <div id="burguer-menu">
            <i class="fas fa-bars"></i>
            <p>Menú</p>
        </div>
        <a href="/" class="mobile-logo">
            <img src="/img/logo.jpg" alt="Macramé Rose" style="height: 40px;">
        </a>
        <a href="/cart" class="mobile-cart">
            <i class="fas fa-shopping-bag"></i>
        </a>
    </div>
    
    <!-- Top Header: Search & Account -->
    <div id="top-header">
        <div id="div-search">
            <form action="/search" method="GET" class="form-search-header">
                <input type="text" name="keywords" placeholder="Buscar productos..." class="area-search">
                <button type="submit" class="button-search">
                    <i class="fas fa-search"></i>
                </button>
            </form>
        </div>
        <div id="login-register">
            <% if (locals.isLogged) { %>
                <ul>
                    <li>
                        <a href="/user/profile" class="profile-a">
                            <img src="/img/avatars/<%= locals.userLogged.avatar %>" class="user-avatar-header" alt="avatar">
                            <strong>Hola, <%= locals.userLogged.userName %></strong>
                        </a>
                    </li>
                    <li>
                        <a href="/user/logout">
                            <i class="fas fa-sign-out-alt"></i> Salir
                        </a>
                    </li>
                </ul>
            <% } else { %>
                <ul>
                    <li>
                        <a href="/user/register">
                            <i class="fas fa-user-plus"></i> Crear cuenta
                        </a>
                    </li>
                    <li>
                        <a href="/user/login">
                            <i class="fas fa-sign-in-alt"></i> Iniciar sesión
                        </a>
                    </li>
                </ul>
            <% } %> 
        </div>
    </div>
    
    <!-- Main Header: Logo & Navigation -->
    <div id="bottom-header">
        <div class="div-logo">
            <a href="/"><img src="/img/logo.jpg" alt="Macramé Rose" id="logo"></a>
        </div>
        <nav class="div-nav-bar">
            <ul>
                <li><a href="/">Inicio</a></li>
                <li><a href="/products">Productos</a></li>
                <li><a href="/shipping">Envíos</a></li>
                <li><a href="/contact">Contacto</a></li>
                <li><a href="/about">Nosotros</a></li>
                <li class="cart"><a href="/cart"><i class="fas fa-shopping-bag"></i> Carrito</a></li>
            </ul>
        </nav>
        <div class="div-cart">
            <a href="/cart">
                <i class="fas fa-shopping-bag"></i>
                <span>Carrito</span>
            </a>
        </div>
    </div>
</header>
{
  "name": "macrame-rose",
  "version": "2.0.0",
  "description": "Tienda online de artículos de macramé: Porta macetas, Almohadones, Bolsos, Cortinas, Accesorios, Adornos y Espejos.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:reset": "npx sequelize-cli db:migrate:undo:all && npm run db:migrate && npm run db:seed"
  },
  "keywords": ["macrame", "ecommerce", "tienda", "artesania"],
  "author": "Layla Rodas",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laylarodas/macrameRose.git"
  },
  "bugs": {
    "url": "https://github.com/laylarodas/macrameRose/issues"
  },
  "homepage": "https://github.com/laylarodas/macrameRose#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
